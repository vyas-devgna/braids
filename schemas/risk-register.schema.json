{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Braids RiskRegister",
  "type": "object",
  "required": ["selected_depth", "depth_reasons", "risks"],
  "properties": {
    "selected_depth": {"enum": ["D0", "D1", "D2", "D3", "D4"]},
    "depth_reasons": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "factors", "impact", "mitigation", "residual_risk"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "factors": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "impact": {"type": "string", "minLength": 1},
          "mitigation": {"type": "string"},
          "residual_risk": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
